$gitignore = @'
# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.pyc
env/
venv/
.venv/
backend/.venv/

# Byte-compiled / distribution
build/
dist/
*.egg-info/

# IDEs
.vscode/
.idea/

# Node/Frontend
node_modules/
dist/
.build/

# Logs
*.log

# Secrets
.env
.env.*.local
'@

Set-Content -Path .gitignore -Value $gitignore -Encoding UTF8
